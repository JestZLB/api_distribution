# Build output
/build/bin/
/api_distribution
/api_distribution.exe
/build/windows/installer/*.exe
/build/windows/installer/output/

# Embedded frontend dist (regenerated on `wails build`)
/frontend/dist/

# Frontend dependencies + build cache
/frontend/node_modules/
/frontend/.vite/
/frontend/*.tsbuildinfo
/frontend/package.json.md5
/frontend/frontend/tsc_output.txt

# Wails generated bindings (regenerated on `wails dev` / `wails build`)
/frontend/wailsjs/

# Local user config (never commit — contains real API keys)
/config.json

# IDE
/.idea/
/.vscode/
!.vscode/settings.json
!.vscode/extensions.json
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Logs and runtime artifacts
*.log
*.tmp
*.bak

# Go build cache (local)
/vendor/

# Frontend dev caches
.eslintcache
.parcel-cache/
.turbo/
.next/
.nuxt/

# Coverage / test output
coverage/
*.cover
*.out
